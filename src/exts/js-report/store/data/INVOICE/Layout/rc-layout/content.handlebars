<html>
    <head>
        <style>
          {{asset "rc-layout-styles.css" "utf8"}}
        </style>
    </head>
    <body>
        {{#each $pdf.pages}}
          {{#if @index}}
            <div style="page-break-before: always;"></div>
          {{/if}}
          <main class="main">
            <header class="header">
              {{#with (lookup ../$pdf.pages @index)}}
                <table class="w-full">
                    <tr class="top">
                        <td class="identity">
                            <strong class="company_name">{{ group.company_name }}</strong>
                            <p class="company_address">{{group.company_address}}</p>
                            <p class="company_phone_number">Telp/Whatsapp : {{group.company_phone_number}}</p>
                        </td>
                        <td class="logo">
                            <img class = 'company-logo' src="{{asset "/INVOICE/Assets/logo.png" "dataURI"}}" />
                        </td>
                        <td class = "invoice">
                            <h1 class="invoice_text">INVOICE</h1>
                            <p class="no_invoice_text">No: {{group.no_invoice}}</p>
                        </td>
                    </tr>
                </table>
                {{/with}}
            </header>
            <footer class="footer text-left">
                <div>
                  <p>Hormat Kami</p>
                  <h3>Dewa Nasib Trans</h3>
                  <div class="hand_sign"></div>
                  <p>Iwan Setiawan</p>
                </div>
            </footer>
          </main>
        {{/each}}
    </body>
</html>
